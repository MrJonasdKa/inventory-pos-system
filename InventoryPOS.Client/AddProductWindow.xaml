<Window x:Class="InventoryPOS.Client.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Product" Height="360" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="SKU"/>
        <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <TextBlock Text="Name"/>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <TextBlock Text="Unit Price"/>
        <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <TextBlock Text="Cost Price"/>
        <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <TextBlock Text="Reorder Threshold"/>
        <TextBox Text="{Binding ReorderThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Button Content="Save" Command="{Binding SaveCommand}" Height="30"/>
    </StackPanel>
</Window>
