<Window x:Class="InventoryPOS.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory POS — Sign In"
        Height="280" Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Inventory POS" FontSize="20" FontWeight="Bold"/>

        <TextBlock Grid.Row="2" Text="Username"/>
        <TextBox Grid.Row="3" x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Text="Password"/>
        <PasswordBox Grid.Row="5" x:Name="PasswordBox"/>

        <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>

        <Button Grid.Row="8" Content="Sign In" Click="SignInButton_Click" Height="32"/>
    </Grid>
</Window>
