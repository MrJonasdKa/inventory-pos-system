<Window x:Class="InventoryPOS.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory POS" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#2D2D30">
            <TextBlock Text="{Binding LoggedInUserName}" Foreground="White" Margin="12" FontWeight="Bold"/>
            <Button Content="Inventory" Command="{Binding NavigateToInventoryCommand}" Margin="8,4"/>
            <Button Content="Point of Sale" Command="{Binding NavigateToPosCommand}" Margin="8,4"/>
            <Button Content="Reports" Command="{Binding NavigateToReportsCommand}" Margin="8,4"/>
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="16"/>
    </Grid>
</Window>
