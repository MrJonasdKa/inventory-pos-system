<UserControl x:Class="InventoryPOS.Client.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Add Product" Command="{Binding OpenAddProductCommand}"/>
            <TextBlock Text="Inventory" FontSize="22" FontWeight="Bold"/>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=C}"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding QuantityOnHand}"/>
                <DataGridTextColumn Header="Reorder At" Binding="{Binding ReorderThreshold}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
