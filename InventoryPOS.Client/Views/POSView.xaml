<UserControl x:Class="InventoryPOS.Client.Views.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Point of Sale" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

            <TextBlock Text="Product"/>
            <ComboBox ItemsSource="{Binding AvailableProducts}"
                      SelectedItem="{Binding SelectedProduct}"
                      DisplayMemberPath="Name" Margin="0,0,0,8"/>

            <TextBlock Text="Quantity"/>
            <TextBox Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

            <Button Content="Add to Cart" Command="{Binding AddToCartCommand}"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Cart" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

            <DataGrid ItemsSource="{Binding Cart}" AutoGenerateColumns="False" IsReadOnly="True" Height="240">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}"/>
                    <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=C}"/>
                    <DataGridTemplateColumn Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove"
                                        Command="{Binding DataContext.RemoveFromCartCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding Total, StringFormat='Total: {0:C}'}" FontSize="18" FontWeight="Bold" Margin="0,12,0,8"/>

            <Button Content="Complete Sale" Command="{Binding CompleteSaleCommand}" Height="36"/>

            <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
